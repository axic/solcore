import std.{*};
import std.dispatch.{*};
import std.Generic.{*};
import std.StorageGeneric.{*};

// A Solidity-style struct used directly as a contract storage field.
//
// A `struct` is a single-constructor product, so it stores exactly like the
// `Triple` product in storage_adt_field.solc: each field occupies its own
// StorageSize-many slots (here 2 uint256 words = 2 slots), reached through the
// derived storage(Point):CanStore(Point) instance. The whole struct can be
// written and read back, or destructured with `match`.
//
// A single field is read and written through dot notation with a member-access
// chain that touches only that field's slot — no whole-struct load/store:
//   - `p.x`     => RVA.acc(MemberAccessProxy(LVA.acc(<p>), Point_x_ssel))
//   - `p.x = v` => Assign.assign(LVA.acc(MemberAccessProxy(LVA.acc(<p>), Point_x_ssel)), v)
// The struct's storage handle (from LVA.acc on the contract field) is offset by
// StorageSize(preceding fields) to reach the field's own slot, so `setX` emits
// a single SSTORE and `getX` a single SLOAD rather than rewriting/reloading the
// entire struct.

struct Point {
  x: uint256;
  y: uint256;
}

contract C {
  p : Point;

  constructor() {
    // product: size uint256 * 2 = 2 slots
    assert(StorageSize.size(Proxy : Proxy(Point)) == 2);
  }

  // whole-struct write
  public function setPoint(a : uint256, b : uint256) -> () {
    p = Point(a, b);
  }

  // read back by destructuring with match
  public function sumMatch() -> uint256 {
    match p {
    | Point(a, b) => return a + b;
    }
  }

  // read a single field via dot access on the storage struct
  public function getX() -> uint256 {
    return p.x;
  }

  public function getY() -> uint256 {
    return p.y;
  }

  // write a single field via dot access (read-modify-write the whole struct)
  public function setX(v : uint256) -> () {
    p.x = v;
  }

  public function setY(v : uint256) -> () {
    p.y = v;
  }
}
